# ─────────────────────────────────────────────────────────────
# MinhaCorretora — Backend
# Copie para .env e preencha. O .env NUNCA vai para o git.
# ─────────────────────────────────────────────────────────────

# --- Aplicação ---
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
API_PREFIX=/api

# Zero = não confiar em X-Forwarded-*. Em produção atrás de um único proxy
# reverso/ALB, use 1 e mantenha a API inacessível diretamente pela internet.
TRUST_PROXY_HOPS=0

# --- CORS ---
# Origens permitidas, separadas por vírgula. Em produção, informe o domínio real.
# Nunca use "*": a API trafega cookie de sessão.
CORS_ORIGINS=http://localhost:5173

# --- Logs ---
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Rate limit global ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ─────────────────────────────────────────────────────────────
# Banco de dados — MySQL 8.4
# ─────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306

# Usuário da APLICAÇÃO, criado por database/security/001_usuario_aplicacao.sql.
# Ele tem apenas SELECT/INSERT/UPDATE/DELETE. Não use root aqui.
DB_USER=minhacorretora_bi_app
DB_PASSWORD=

DB_NAME=minhacorretora_bi
DB_CONNECTION_LIMIT=10

# Credencial DDL exclusiva para `npm run db:migrate`. Não é usada pela API.
DB_MIGRATOR_USER=
DB_MIGRATOR_PASSWORD=

# TLS na conexão com o banco. Deixe false apenas se o MySQL estiver na mesma
# máquina; com o banco em outro host, container ou RDS, use true.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Cópias auditáveis das planilhas. Em produção, use um caminho ABSOLUTO fora do
# deploy, com permissões só para a conta da aplicação, e uma chave aleatória:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ARQUIVOS_DIR=./armazenamento
ARQUIVOS_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# Sessão
# ─────────────────────────────────────────────────────────────

# OBRIGATÓRIO, mínimo 32 caracteres. Gere um valor aleatório:
#   openssl rand -base64 48
# Trocar este segredo invalida todos os access tokens em circulação.
JWT_SECRET=

# Chave das credenciais de integração gravadas cifradas (AES-256-GCM).
# Separada do JWT_SECRET de propósito: girar o segredo do JWT é rotina de
# segurança de sessão e não deveria inutilizar as credenciais das seguradoras.
# Sem ela o sistema deriva do JWT_SECRET e avisa no boot.
# Gere com: openssl rand -base64 48
SEGREDOS_KEY=

JWT_ISSUER=minhacorretora-bi
JWT_AUDIENCE=minhacorretora-bi-web

# Access token curto: é ele que fica no navegador e não dá para revogar
# antes da hora. 15 minutos limita a janela de uso de um token vazado.
ACCESS_TOKEN_TTL_MIN=15

# Refresh token: longo, mas revogável a qualquer momento pelo banco.
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=ssbi_rt

# Domínio do cookie. Vazio = só o host atual (mais restrito, prefira assim).
COOKIE_DOMAIN=

# Deixe vazio para acompanhar o ambiente (true em produção, false em dev).
# Em produção, false é recusado na subida.
COOKIE_SECURE=

# ─────────────────────────────────────────────────────────────
# Política de senha e bloqueio
# ─────────────────────────────────────────────────────────────
SENHA_TAMANHO_MINIMO=12

# Bloqueio por conta: protege um usuário específico contra força bruta.
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# Rate limit por IP no endpoint de login: protege contra password spraying
# (uma senha comum testada em muitas contas, que nunca estoura o contador acima).
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# ─────────────────────────────────────────────────────────────
# Redefinição de senha por e-mail ("esqueci minha senha")
# ─────────────────────────────────────────────────────────────

# Endereço PÚBLICO do frontend. É a base do link que vai no e-mail, então
# precisa ser a URL que o usuário consegue abrir — não "localhost" se o sistema
# estiver num servidor. Em produção a aplicação RECUSA subir com http://.
APP_URL=http://localhost:5173

# Validade do link, em minutos. Curto de propósito: o e-mail chega em segundos e
# a pessoa usa na hora. Horas de validade só alongam a janela em que um e-mail
# lido por outra pessoa ainda vale como credencial.
RESET_SENHA_TTL_MIN=30

# Teto de pedidos por CONTA, por hora. Impede que o formulário público seja
# usado para encher a caixa de entrada de alguém — o rate limit por IP não
# cobre esse caso, porque o ataque vem de muitos IPs contra um alvo só.
RESET_SENHA_MAX_POR_HORA=3

# ─────────────────────────────────────────────────────────────
# SMTP — envio de e-mail
#
# PREFIRA A TELA: Configurações › E-mail de disparo (056) guarda as caixas
# no banco, com a senha cifrada, e a padrão ATIVA vence estas variáveis.
# Elas ficam como alternativa — usadas só sem nenhuma caixa padrão
# ativa na tela.
#
# OPCIONAL. Sem SMTP_HOST e SMTP_FROM preenchidos, o sistema continua
# funcionando ponta a ponta: o token é gerado e gravado normalmente, e o link
# aparece no LOG do backend em vez de ir por e-mail. É assim que se testa o
# fluxo em desenvolvimento sem caixa de saída.
#
# Exemplos de host/porta:
#   Microsoft 365    smtp.office365.com    587   SECURE=false (STARTTLS)
#   Google Workspace smtp.gmail.com        587   SECURE=false (STARTTLS)
#   Zoho             smtp.zoho.com         465   SECURE=true
#
# Em Microsoft 365 e Google Workspace, SMTP_PASS NÃO é a senha da pessoa: é uma
# senha de aplicativo / credencial de envio gerada no painel do provedor.
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587

# true = TLS desde a conexão (porta 465). false = STARTTLS (porta 587).
SMTP_SECURE=false

# Deixe vazios se o relay autenticar por IP (comum em servidor interno).
SMTP_USER=
SMTP_PASS=

# Remetente exibido. Use uma caixa que ninguém lê ("não responda") e que esteja
# no domínio com SPF/DKIM configurado — sem isso o e-mail cai em spam.
SMTP_FROM="MinhaCorretora <nao-responda@exemplo.com.br>"

SMTP_TIMEOUT_MS=15000

# ─── Consulta de CEP ───
# Um ou mais endereços separados por vírgula, com {cep} no lugar do número.
# Tentados em ordem. Padrão: ViaCEP. Uma instância própria (ex.: BrasilCEP em
# http://localhost:8080/cep/{cep}) pode vir na frente da lista.
CEP_API_URLS=https://viacep.com.br/ws/{cep}/json/
CEP_TIMEOUT_MS=4000

# ─── Consulta de CNPJ ───
# Dados abertos da Receita, sem chave. Tentados em ordem, como o CEP.
CNPJ_API_URLS=https://brasilapi.com.br/api/cnpj/v1/{cnpj},https://publica.cnpj.ws/cnpj/{cnpj}
CNPJ_TIMEOUT_MS=8000

# ─── Notificações por e-mail ───
# O aviso é pelo sistema (sino do topo). E-mail só com esta chave E o SMTP acima.
NOTIFICAR_POR_EMAIL=false
