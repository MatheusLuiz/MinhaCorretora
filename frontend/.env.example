# ─────────────────────────────────────────────────────────────
# MinhaCorretora — Frontend
# Copie para .env. Atenção: tudo com prefixo VITE_ vai para o
# bundle e fica VISÍVEL no navegador. Nunca coloque segredo aqui.
# ─────────────────────────────────────────────────────────────

# Caminho base da API. Em dev, "/api" passa pelo proxy do Vite.
VITE_API_BASE_URL=/api

# Destino do proxy de desenvolvimento (usado só pelo vite.config.ts).
VITE_API_PROXY_TARGET=http://localhost:3333

# Nome exibido na interface.
VITE_APP_NAME=MinhaCorretora

# Expor o servidor de desenvolvimento na rede local (0.0.0.0), para que outras
# máquinas abram pelo IP desta. Ligado por padrão.
#
# Coloque false em rede pública (cafeteria, aeroporto, coworking): escutar em
# 0.0.0.0 entrega o servidor a qualquer um no mesmo Wi-Fi.
VITE_EXPOR_NA_REDE=true
